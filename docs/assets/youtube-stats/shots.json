{
  "plugin": "youtube-stats",
  "_comment": "The plugin keeps its numbers in self.channel_stats -- title, subscribers and views -- and display() calls update() unless _has_fetched is already True, so the fixture sets both and no request is made. last_displayed_stats must stay None or display() short-circuits as an unchanged redraw. The channel name and figures are invented; no API key is used.",
  "defaults": {
    "width": 128,
    "height": 32,
    "scale": 6,
    "skip_update": true,
    "config": {
      "enabled": true,
      "channel_id": "UCexample",
      "api_key": "not-used-in-render"
    }
  },
  "shots": [
    {
      "name": "hero",
      "attrs": {
        "channel_stats": {
          "title": "ChuckBuilds",
          "subscribers": 48213,
          "views": 3927455
        },
        "_has_fetched": true,
        "last_displayed_stats": null,
        "_api_key_error": null
      }
    },
    {
