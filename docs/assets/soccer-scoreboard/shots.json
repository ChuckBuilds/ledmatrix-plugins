{
  "plugin": "soccer-scoreboard",
  "_comment": "Soccer keeps one manager per league and mode as a plain attribute named from the league slug -- eng.1 becomes eng1_live, eng1_recent, eng1_upcoming -- and only builds them for leagues whose enabled flag is set, so the config below turns the Premier League on and everything else off. Unlike the other scoreboards there are only three display modes in total (soccer_live/recent/upcoming), shared across every league, rather than three per league. Every mode's display() returns early unless games_list is populated, and the live path also reads live_games and active_celebration. The card reads home_logo_path/away_logo_path off the game dict as Path objects, and period_text is what soccer_managers.py builds for that state: 1H, 2H, HALF, ET1, ET2, ETH, PEN while live, and Final, F/ET or F/Pen once over. Teams, scores and records are invented.",
  "defaults": {
    "width": 128,
    "height": 32,
    "scale": 6,
    "freeze_time": "2026-04-12T14:00:00+00:00",
    "skip_update": true,
    "config": {
      "enabled": true,
      "leagues": {
        "eng.1": {
          "enabled": true
        },
        "esp.1": {
          "enabled": false
        },
        "ger.1": {
          "enabled": false
        },
        "ita.1": {
          "enabled": false
        },
        "fra.1": {
          "enabled": false
        },
        "usa.1": {
          "enabled": false
        },
        "por.1": {
          "enabled": false
        }
      }
    }
  },
