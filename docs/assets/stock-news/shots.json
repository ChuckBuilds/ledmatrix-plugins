    "width": 128,
    "height": 32,
    "scale": 6,
    "skip_update": true,
    "frames": 60,
    "config": {
      "enabled": true,
      "global": {
        "logo_url_template": "http://docs-logo.invalid/{symbol}.png"
      }
    },
