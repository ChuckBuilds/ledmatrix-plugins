{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MQTT Notifications Plugin Configuration",
  "description": "Configuration schema for the MQTT Notifications plugin - displays messages from HomeAssistant via MQTT",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Enable or disable the MQTT notifications plugin"
    },
    "display_duration": {
      "type": "number",
      "default": 10,
      "minimum": 1,
      "maximum": 300,
      "description": "Default display duration in seconds when not specified in message",
      "x-advanced": true
    },
    "update_interval": {
      "type": "integer",
      "default": 60,
      "minimum": 1,
      "description": "How often to check MQTT connection health in seconds",
      "x-advanced": true
    },
    "mqtt": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "default": "localhost",
          "description": "MQTT broker hostname or IP address"
        },
        "port": {
          "type": "integer",
          "default": 1883,
          "minimum": 1,
          "maximum": 65535,
          "description": "MQTT broker port"
        },
        "username": {
          "type": "string",
          "default": "",
          "description": "MQTT broker username (optional)"
        },
        "password": {
          "type": "string",
          "default": "",
          "description": "MQTT broker password (optional)"
        },
        "client_id": {
          "type": "string",
          "default": "ledmatrix-mqtt-notifications",
          "description": "MQTT client ID",
          "x-advanced": true
        },
        "keepalive": {
          "type": "integer",
          "default": 60,
          "minimum": 10,
          "maximum": 300,
          "description": "MQTT keepalive interval in seconds",
          "x-advanced": true
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["homeassistant/ledmatrix/+"],
          "description": "Array of MQTT topics to subscribe to. Supports wildcards: + (single level) and # (multi-level)"
        }
      },
      "required": ["host", "port"],
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "properties": {
        "default_duration": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 300,
          "description": "Default display duration in seconds when not specified in message"
        }
      },
      "additionalProperties": false
    },
    "text": {
      "type": "object",
      "properties": {
        "font_path": {
          "type": "string",
          "default": "assets/fonts/PressStart2P-Regular.ttf",
          "description": "Path to font file (TTF or BDF format). Relative to project root or absolute path.",
          "x-advanced": true
        },
        "font_size": {
          "type": "number",
          "default": 8,
          "minimum": 4,
          "maximum": 32,
          "description": "Font size in pixels",
          "x-advanced": true
        },
        "text_color": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [255, 255, 255],
          "description": "RGB text color [R, G, B]",
          "x-advanced": true
        },
        "background_color": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [0, 0, 0],
          "description": "RGB background color [R, G, B]",
          "x-advanced": true
        },
        "scroll": {
          "type": "boolean",
          "default": true,
          "description": "Enable scrolling animation for text. If false, text is displayed statically."
        },
        "scroll_speed": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 200,
          "description": "Scroll speed in pixels per second. Higher values = faster scrolling.",
          "x-advanced": true
        },
        "scroll_gap_width": {
          "type": "number",
          "default": 32,
          "minimum": 0,
          "description": "Gap width in pixels between scroll loops",
          "x-advanced": true
        }
      },
      "additionalProperties": false
    },
    "customization": {
      "type": "object",
      "title": "Display Customization",
      "description": "Customize the font for the notification text. Text and background colors are configured under Text (text_color / background_color). A non-default selection here overrides text.font_path / text.font_size.",
      "properties": {
        "message_text": {
          "type": "object",
          "title": "Message Text",
          "description": "Font settings for the notification message text",
          "properties": {
            "font": {
              "type": "string",
              "title": "Font Family",
              "description": "Select the font to use",
              "enum": [
                "PressStart2P-Regular.ttf",
                "4x6-font.ttf",
                "5by7.regular.ttf",
                "5x7.bdf",
                "4x6.bdf",
                "cozette.bdf"
              ],
              "default": "PressStart2P-Regular.ttf",
              "x-advanced": true
            },
            "font_size": {
              "type": "integer",
              "title": "Font Size",
              "description": "Font size in pixels",
              "minimum": 4,
              "maximum": 32,
              "default": 8,
              "x-advanced": true
            }
          },
          "x-propertyOrder": ["font", "font_size"],
          "additionalProperties": false
        }
      },
      "x-propertyOrder": ["message_text"],
      "additionalProperties": false
    }
  },
  "required": ["enabled", "mqtt"],
  "additionalProperties": false
}
