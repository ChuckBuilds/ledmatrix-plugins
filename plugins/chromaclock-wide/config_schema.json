{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "ChromaClock Wide Configuration",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "style": {
      "type": "string",
      "default": "cycle",
      "enum": [
        "cycle",
        "neon",
        "prism",
        "starfield",
        "matrix",
        "fire",
        "horizon",
        "binary",
        "minimal",
        "pulse",
        "wave",
        "aurora",
        "rain",
        "flap",
        "morph",
        "outline",
        "words",
        "dotgrid",
        "moon",
        "dayprogress",
        "world",
        "pong",
        "tetris",
        "aquarium",
        "snow",
        "lava",
        "pacman",
        "analog",
        "bighour"
      ]
    },
    "cycle_seconds": {
      "type": "integer",
      "default": 20,
      "minimum": 5,
      "maximum": 3600,
      "description": "Seconds between style changes in Cycle mode"
    },
    "preview_mode": {
      "type": "boolean",
      "default": false,
      "description": "Pin the selected Preview Style on the physical display"
    },
    "preview_style": {
      "type": "string",
      "default": "neon",
      "enum": [
        "neon",
        "prism",
        "starfield",
        "matrix",
        "fire",
        "horizon",
        "binary",
        "minimal",
        "pulse",
        "wave",
        "aurora",
        "rain",
        "flap",
        "morph",
        "outline",
        "words",
        "dotgrid",
        "moon",
        "dayprogress",
        "world",
        "pong",
        "tetris",
        "aquarium",
        "snow",
        "lava",
        "pacman",
        "analog",
        "bighour"
      ]
    },
    "palette": {
      "type": "string",
      "default": "rainbow",
      "enum": [
        "rainbow",
        "cyan",
        "magenta",
        "amber",
        "green"
      ]
    },
    "use_24h": {
      "type": "boolean",
      "default": false
    },
    "show_date": {
      "type": "boolean",
      "default": true
    },
    "show_seconds": {
      "type": "boolean",
      "default": true
    },
    "glow": {
      "type": "boolean",
      "default": true
    },
    "timezone": {
      "type": "string",
      "default": "America/New_York"
    },
    "brightness": {
      "type": "number",
      "minimum": 0.15,
      "maximum": 1,
      "default": 0.85
    },
    "display_duration": {
      "type": "number",
      "minimum": 1,
      "maximum": 300,
      "default": 30
    },
    "live_preview": {
      "type": "string",
      "default": "live",
      "title": "Live LEDMatrix Preview",
      "description": "Live browser preview of unsaved clock settings",
      "x-widget": "chromaclock-live-preview"
    }
  },
  "required": [
    "enabled"
  ],
  "additionalProperties": false
}