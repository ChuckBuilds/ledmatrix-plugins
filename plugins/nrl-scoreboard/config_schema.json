        "properties": {
          "font": {
            "type": "string",
            "title": "Font Family",
            "description": "Select the font to use",
            "enum": [
              "PressStart2P-Regular.ttf",
              "4x6-font.ttf",
              "5by7.regular.ttf",
              "5x7.bdf",
              "4x6.bdf",
