{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Christmas Countdown Plugin Configuration",
  "description": "Configuration schema for the Christmas Countdown plugin - displays countdown to Christmas with tree logo",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Enable or disable the Christmas countdown plugin"
    },
    "display_duration": {
      "type": "number",
      "default": 15,
      "minimum": 1,
      "maximum": 300,
      "description": "How long to display the countdown in seconds"
    },
    "high_performance_transitions": {
      "type": "boolean",
      "default": false,
      "description": "Use high-performance transitions (120 FPS) instead of standard (30 FPS)",
      "x-advanced": true
    },
    "update_interval": {
      "type": "integer",
      "default": 3600,
      "minimum": 60,
      "maximum": 86400,
      "description": "How often to update the countdown in seconds (default: 1 hour, since countdown changes daily)",
      "x-advanced": true
    },
    "transition": {
      "type": "object",
      "description": "Transition configuration for this plugin",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "redraw",
            "fade",
            "slide",
            "wipe",
            "dissolve",
            "pixelate"
          ],
          "default": "redraw",
          "description": "Type of transition to use",
          "x-advanced": true
        },
        "speed": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 10,
          "description": "Transition speed (1=slow, 10=fast)",
          "x-advanced": true
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable transitions",
          "x-advanced": true
        }
      },
      "additionalProperties": false
    },
    "text_color": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        255,
        0,
        0
      ],
      "description": "RGB color for the countdown text [R, G, B] (default: red)"
    },
    "tree_color": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        0,
        128,
        0
      ],
      "description": "RGB color for the Christmas tree [R, G, B] (default: green). Only used if tree image is not available.",
      "x-advanced": true
    },
    "tree_size": {
      "type": "integer",
      "minimum": 8,
      "maximum": 64,
      "description": "Size of the Christmas tree logo in pixels. If not specified, size is auto-calculated based on display height.",
      "x-advanced": true
    }
  },
  "required": [
    "enabled"
  ],
  "additionalProperties": false
}