{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Stock & Crypto Ticker Plugin Configuration",
  "description": "Configuration schema for the stock and crypto ticker plugin",
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Enable or disable the stock ticker plugin",
      "default": false
    },
    "update_interval": {
      "type": "integer",
      "description": "Data refresh interval in seconds",
      "minimum": 60,
      "maximum": 3600,
      "default": 600
    },
    "show_change": {
      "x-advanced": true,
      "type": "boolean",
      "description": "Show the price change in dollars (e.g. +1.25) for stocks",
      "default": true
    },
    "show_percentage": {
      "x-advanced": true,
      "type": "boolean",
      "description": "Show the price change as a percentage (e.g. (+0.8%)) for stocks",
      "default": true
    },
    "api": {
      "type": "object",
      "description": "Yahoo Finance request settings",
      "properties": {
        "timeout": {
          "x-advanced": true,
          "type": "number",
          "description": "Seconds before a quote request gives up",
          "minimum": 1,
          "maximum": 60,
          "default": 10
        },
        "retry_count": {
          "x-advanced": true,
          "type": "integer",
          "description": "Retries with backoff when a quote request fails with a 429 or 5xx response",
          "minimum": 0,
          "maximum": 10,
          "default": 3
        },
        "rate_limit_delay": {
          "x-advanced": true,
          "type": "number",
          "description": "Seconds to pause between symbols while fetching",
          "minimum": 0,
          "maximum": 5,
          "default": 0.1
        }
      },
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "description": "Display and scrolling settings",
      "properties": {
        "display_mode": {
          "type": "string",
          "enum": [
            "scroll",
            "switch"
          ],
          "default": "scroll",
          "description": "Display mode: 'scroll' shows all tickers in a continuous horizontal scroll, 'switch' shows one ticker at a time rotating on a timer"
        },
        "switch_duration": {
          "type": "number",
          "minimum": 5,
          "maximum": 120,
          "default": 15,
          "description": "Seconds to display each stock/crypto before switching to the next (only used in switch mode)"
        },
        "scroll_speed": {
          "x-advanced": true,
          "type": "number",
          "description": "Pixels moved per scroll step. Speed is scroll_speed / scroll_delay pixels per second (default 1.0 / 0.02 = 50 px/s), moved to the nearest speed the panel can draw in whole pixels.",
          "minimum": 0.5,
          "maximum": 5.0,
          "default": 1.0
        },
        "scroll_delay": {
          "x-advanced": true,
          "type": "number",
          "description": "Seconds per scroll step. A smaller delay scrolls faster.",
          "minimum": 0.001,
          "maximum": 0.1,
          "default": 0.02
        },
        "toggle_chart": {
          "type": "boolean",
          "description": "Enable chart display toggle",
          "default": true
        },
        "chart_width_px": {
          "type": "integer",
          "description": "Width of the mini price chart in pixels (fixed size, does not scale with the display width)",
          "minimum": 8,
          "maximum": 256,
          "default": 64
        },
        "chart_height_px": {
          "type": "integer",
          "description": "Height of the mini price chart in pixels (fixed size, does not scale with the display height; clamped to the panel)",
          "minimum": 6,
          "maximum": 256,
          "default": 32
        },
        "dynamic_duration": {
          "type": "boolean",
          "description": "Enable dynamic duration based on content width",
          "default": true
        },
        "min_duration": {
          "type": "number",
          "description": "Minimum display duration in seconds",
          "minimum": 10,
          "maximum": 300,
          "default": 30
        },
        "max_duration": {
          "type": "number",
          "description": "Maximum display duration in seconds",
          "minimum": 30,
          "maximum": 600,
          "default": 300
        },
        "duration_buffer": {
          "type": "number",
          "description": "Buffer percentage for dynamic duration calculation",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.1
        },
        "stock_gap": {
          "type": "integer",
          "description": "Pixel gap between adjacent stock/crypto entries in the scrolling canvas",
          "minimum": 0,
          "maximum": 128,
          "default": 32
        }
      },
      "additionalProperties": false
    },
    "stocks": {
      "type": "object",
      "description": "Stock ticker configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable stock tracking",
          "default": true
        },
        "symbols": {
          "type": "array",
          "description": "List of Yahoo Finance symbols to track. Plain tickers (AAPL), indexes with a leading caret (^GSPC, ^DJI, ^VIX), futures and commodities with =F (GC=F gold, CL=F crude), class shares with a hyphen (BRK-B), and non-US listings with an exchange suffix (7203.T). More symbols increase fetch time at each update_interval (~0.1s per symbol plus a 1s pause every 15 symbols).",
          "items": {
            "type": "string",
            "pattern": "^\\^?[A-Z0-9]{1,12}([.=-][A-Z0-9]{1,5})*$",
            "maxLength": 20
          },
          "default": [
            "ASTS",
            "SCHD",
            "INTC",
            "NVDA",
            "T",
            "VOO",
            "SMCI"
          ],
          "maxItems": 50
        },
        "display_format": {
          "x-advanced": true,
          "x-display": "hidden",
          "type": "string",
          "description": "Deprecated — no longer used: the layout is fixed. Kept for backward compatibility with existing configs.",
          "title": "Display Format (deprecated)"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "crypto": {
      "type": "object",
      "description": "Cryptocurrency ticker configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable cryptocurrency tracking",
          "default": false
        },
        "update_interval": {
          "type": "integer",
          "description": "How long a crypto quote is reused before it is fetched again, in seconds. Set it below the top-level update_interval to refresh crypto more often than stocks.",
          "minimum": 60,
          "maximum": 3600,
          "default": 600
        },
        "show_change": {
          "x-advanced": true,
          "type": "boolean",
          "description": "Show the price change in dollars for crypto",
          "default": true
        },
        "show_percentage": {
          "x-advanced": true,
          "type": "boolean",
          "description": "Show the price change as a percentage for crypto",
          "default": true
        },
        "symbols": {
          "type": "array",
          "description": "List of cryptocurrency symbols to track. A bare symbol (BTC) is quoted in USD automatically; name the quote currency explicitly to use another (BTC-EUR). Each symbol adds to the total fetch time per update_interval.",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9]{2,10}(-[A-Z]{3,4})?$",
            "maxLength": 15
          },
          "default": [
            "BTC-USD",
            "ETH-USD"
          ],
          "maxItems": 15
        },
        "display_format": {
          "x-advanced": true,
          "x-display": "hidden",
          "type": "string",
          "description": "Deprecated — no longer used: the layout is fixed. Kept for backward compatibility with existing configs.",
          "title": "Display Format (deprecated)"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "customization": {
      "type": "object",
      "description": "Display customization options (colors, fonts, etc.)",
      "properties": {
        "stocks": {
          "type": "object",
          "description": "Stock display customization",
          "properties": {
            "symbol": {
              "type": "object",
              "description": "Symbol text customization (font and color)",
              "properties": {
                "font_size": {
                  "type": "integer",
                  "description": "Font size for symbol text",
                  "minimum": 4,
                  "maximum": 16,
                  "default": 8
                },
                "font": {
                  "type": "string",
                  "description": "Font file to use for symbol text",
                  "enum": [
                    "PressStart2P-Regular.ttf",
                    "4x6-font.ttf",
                    "5by7.regular.ttf",
                    "5x7.bdf",
                    "4x6.bdf"
                  ],
                  "default": "PressStart2P-Regular.ttf"
                },
                "text_color": {
                  "type": "array",
                  "description": "Text color for symbol (RGB)",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "default": [
                    255,
                    255,
                    255
                  ]
                }
              },
              "additionalProperties": false
            },
            "price": {
              "type": "object",
              "description": "Price text customization (font and color)",
              "properties": {
                "font_size": {
                  "type": "integer",
                  "description": "Font size for price text",
                  "minimum": 4,
                  "maximum": 16,
                  "default": 8
                },
                "font": {
                  "type": "string",
                  "description": "Font file to use for price text",
                  "enum": [
                    "PressStart2P-Regular.ttf",
                    "4x6-font.ttf",
                    "5by7.regular.ttf",
                    "5x7.bdf",
                    "4x6.bdf"
                  ],
                  "default": "PressStart2P-Regular.ttf"
                },
                "text_color": {
                  "type": "array",
                  "description": "Text color for price (RGB)",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "default": [
                    255,
                    255,
                    255
                  ]
                }
              },
              "additionalProperties": false
            },
            "price_delta": {
              "type": "object",
              "description": "Price change/percentage text customization (font and colors)",
              "properties": {
                "font_size": {
                  "type": "integer",
                  "description": "Font size for price delta text",
                  "minimum": 4,
                  "maximum": 16,
                  "default": 8
                },
                "font": {
                  "type": "string",
                  "description": "Font file to use for price delta text",
                  "enum": [
                    "PressStart2P-Regular.ttf",
                    "4x6-font.ttf",
                    "5by7.regular.ttf",
                    "5x7.bdf",
                    "4x6.bdf"
                  ],
                  "default": "PressStart2P-Regular.ttf"
                },
                "positive_color": {
                  "type": "array",
                  "description": "Color for positive changes (RGB)",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "default": [
                    0,
                    255,
                    0
                  ]
                },
                "negative_color": {
                  "type": "array",
                  "description": "Color for negative changes (RGB)",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "default": [
                    255,
                    0,
                    0
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "crypto": {
          "type": "object",
          "description": "Crypto display customization",
          "properties": {
            "symbol": {
              "type": "object",
              "description": "Symbol text customization (font and color)",
              "properties": {
                "font_size": {
                  "type": "integer",
                  "description": "Font size for symbol text",
                  "minimum": 4,
                  "maximum": 16,
                  "default": 8
                },
                "font": {
                  "type": "string",
                  "description": "Font file to use for symbol text",
                  "enum": [
                    "PressStart2P-Regular.ttf",
                    "4x6-font.ttf",
                    "5by7.regular.ttf",
                    "5x7.bdf",
                    "4x6.bdf"
                  ],
                  "default": "PressStart2P-Regular.ttf"
                },
                "text_color": {
                  "type": "array",
                  "description": "Text color for symbol (RGB)",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "default": [
                    255,
                    215,
                    0
                  ]
                }
              },
              "additionalProperties": false
            },
            "price": {
              "type": "object",
              "description": "Price text customization (font and color)",
              "properties": {
                "font_size": {
                  "type": "integer",
                  "description": "Font size for price text",
                  "minimum": 4,
                  "maximum": 16,
                  "default": 8
                },
                "font": {
                  "type": "string",
                  "description": "Font file to use for price text",
                  "enum": [
                    "PressStart2P-Regular.ttf",
                    "4x6-font.ttf",
                    "5by7.regular.ttf",
                    "5x7.bdf",
                    "4x6.bdf"
                  ],
                  "default": "PressStart2P-Regular.ttf"
                },
                "text_color": {
                  "type": "array",
                  "description": "Text color for price (RGB)",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "default": [
                    255,
                    215,
                    0
                  ]
                }
              },
              "additionalProperties": false
            },
            "price_delta": {
              "type": "object",
              "description": "Price change/percentage text customization (font and colors)",
              "properties": {
                "font_size": {
                  "type": "integer",
                  "description": "Font size for price delta text",
                  "minimum": 4,
                  "maximum": 16,
                  "default": 8
                },
                "font": {
                  "type": "string",
                  "description": "Font file to use for price delta text",
                  "enum": [
                    "PressStart2P-Regular.ttf",
                    "4x6-font.ttf",
                    "5by7.regular.ttf",
                    "5x7.bdf",
                    "4x6.bdf"
                  ],
                  "default": "PressStart2P-Regular.ttf"
                },
                "positive_color": {
                  "type": "array",
                  "description": "Color for positive changes (RGB)",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "default": [
                    0,
                    255,
                    0
                  ]
                },
                "negative_color": {
                  "type": "array",
                  "description": "Color for negative changes (RGB)",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "default": [
                    255,
                    0,
                    0
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "enabled"
  ],
  "additionalProperties": false
}
