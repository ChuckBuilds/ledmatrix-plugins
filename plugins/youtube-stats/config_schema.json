{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "YouTube Stats Plugin Configuration",
  "description": "Configuration schema for the YouTube Stats plugin - displays YouTube channel statistics including subscriber count, total views, and channel name",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Enable or disable the YouTube Stats plugin"
    },
    "channel_id": {
      "type": "string",
      "description": "YouTube channel ID (e.g., UCxxxxx...). Find your channel ID at https://www.youtube.com/account_advanced",
      "minLength": 1
    },
    "api_key": {
      "type": "string",
      "description": "YouTube Data API v3 key (required - get one at https://console.cloud.google.com/apis/credentials). Store in config_secrets.json for security.",
      "title": "API Key",
      "x-secret": true
    },
    "update_interval": {
      "type": "integer",
      "default": 300,
      "minimum": 60,
      "maximum": 3600,
      "description": "Update interval in seconds. How often to fetch fresh channel statistics from YouTube API (60-3600 seconds)"
    },
    "display_duration": {
      "type": "number",
      "default": 15,
      "minimum": 5,
      "maximum": 60,
      "description": "How long to display the channel stats on screen in seconds (5-60 seconds)"
    },
    "customization": {
      "type": "object",
      "title": "Display Customization",
      "description": "Customize fonts and colors for the channel stats text elements",
      "properties": {
        "channel_name": {
          "type": "object",
          "title": "Channel Name",
          "description": "Font settings for the channel name (top line)",
          "properties": {
            "font": {
              "type": "string",
              "title": "Font Family",
              "description": "Select the font to use",
              "enum": [
                "PressStart2P-Regular.ttf",
                "4x6-font.ttf",
                "5by7.regular.ttf",
                "5x7.bdf",
                "4x6.bdf"
              ],
              "default": "PressStart2P-Regular.ttf",
              "x-advanced": true
            },
            "font_size": {
              "type": "integer",
              "title": "Font Size",
              "description": "Font size in pixels",
              "minimum": 4,
              "maximum": 16,
              "default": 8,
              "x-advanced": true
            },
            "text_color": {
              "type": "array",
              "title": "Text Color",
              "description": "Text color (RGB)",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "minItems": 3,
              "maxItems": 3,
              "default": [255, 255, 255]
            }
          },
          "x-propertyOrder": ["font", "font_size", "text_color"],
          "additionalProperties": false
        },
        "subscriber_count": {
          "type": "object",
          "title": "Subscriber Count",
          "description": "Font settings for the subscriber count (middle line)",
          "properties": {
            "font": {
              "type": "string",
              "title": "Font Family",
              "description": "Select the font to use",
              "enum": [
                "PressStart2P-Regular.ttf",
                "4x6-font.ttf",
                "5by7.regular.ttf",
                "5x7.bdf",
                "4x6.bdf"
              ],
              "default": "PressStart2P-Regular.ttf",
              "x-advanced": true
            },
            "font_size": {
              "type": "integer",
              "title": "Font Size",
              "description": "Font size in pixels",
              "minimum": 4,
              "maximum": 16,
              "default": 8,
              "x-advanced": true
            },
            "text_color": {
              "type": "array",
              "title": "Text Color",
              "description": "Text color (RGB)",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "minItems": 3,
              "maxItems": 3,
              "default": [255, 255, 255]
            }
          },
          "x-propertyOrder": ["font", "font_size", "text_color"],
          "additionalProperties": false
        },
        "view_count": {
          "type": "object",
          "title": "View Count",
          "description": "Font settings for the total view count (bottom line)",
          "properties": {
            "font": {
              "type": "string",
              "title": "Font Family",
              "description": "Select the font to use",
              "enum": [
                "PressStart2P-Regular.ttf",
                "4x6-font.ttf",
                "5by7.regular.ttf",
                "5x7.bdf",
                "4x6.bdf"
              ],
              "default": "PressStart2P-Regular.ttf",
              "x-advanced": true
            },
            "font_size": {
              "type": "integer",
              "title": "Font Size",
              "description": "Font size in pixels",
              "minimum": 4,
              "maximum": 16,
              "default": 8,
              "x-advanced": true
            },
            "text_color": {
              "type": "array",
              "title": "Text Color",
              "description": "Text color (RGB)",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "minItems": 3,
              "maxItems": 3,
              "default": [255, 255, 255]
            }
          },
          "x-propertyOrder": ["font", "font_size", "text_color"],
          "additionalProperties": false
        }
      },
      "x-propertyOrder": ["channel_name", "subscriber_count", "view_count"],
      "additionalProperties": false
    }
  },
  "required": [
    "enabled",
    "channel_id",
    "api_key"
  ],
  "additionalProperties": false
}