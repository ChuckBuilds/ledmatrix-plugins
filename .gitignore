# Secrets (contains API tokens)
config_secrets.json

# Secrets (plugin-level)
plugins/**/config_secrets.json

# Asset backups (local working copies)
plugins/*/assets/**/*_backup/

# RGBMatrixEmulator writes this into the working directory on first run,
# so the plugin test suites drop one wherever they are invoked from.
# ledmatrix-music/emulator_config.json is committed on purpose and stays
# tracked -- .gitignore does not apply to files already in the index.
emulator_config.json

# Debug output the flights map composer writes when debug logging is on.
# It lands in the process CWD, which on an install is the core checkout.
debug_composite.png
debug_cropped.png

# Company logos the stock-news ticker downloads at runtime. The plugin caches
# them next to itself (plugins/stock-news/assets/logos), so without this a
# local run leaves third-party logo files sitting untracked in the plugin tree.
plugins/stock-news/assets/logos/
